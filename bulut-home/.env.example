# BULUT HOME ayarları — bu dosyayı .env olarak kopyala. .env Git'e eklenmez.

# Veritabanı ve veri klasörü (Docker içinde /data volume'u)
BULUT_DATA_DIR=./data

# Oturum çerezi için rastgele uzun bir değer: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
BULUT_SECRET_KEY=

# HTTPS arkasında (Tailscale Serve) çalışıyorsan 1 yap; çerez Secure olur.
BULUT_COOKIE_SECURE=0

# --- Model sağlayıcıları (en az birini doldur) ---
ANTHROPIC_API_KEY=
# OpenAI uyumlu herhangi bir sağlayıcı (DeepSeek, OpenRouter, Groq, OpenAI...)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_MODEL=deepseek-chat
# Bu sağlayıcının 1M token fiyatı (USD). Bilinmiyorsa boş bırak; maliyet "bilinmiyor" diye kaydedilir
# ve bütçe koruması bu sağlayıcıyı ücretli çağrılar için kapatır.
OPENAI_COMPAT_PRICE_IN=
OPENAI_COMPAT_PRICE_OUT=

# Model katmanları: ekonomik (basit işler) ve akıllı (karmaşık işler)
BULUT_MODEL_FAST=anthropic:claude-haiku-5-5
BULUT_MODEL_SMART=anthropic:claude-sonnet-5-5
# Yedek zincir (sağlayıcı hatasında sırayla denenir), virgülle ayrılmış
BULUT_MODEL_FALLBACKS=openai_compat:default

# --- Bütçe ---
BULUT_MONTHLY_BUDGET_TRY=400
# 1 USD kaç TL? Güncel kuru kendin gir. Kur girilmezse bütçe kontrolü güvenli tarafta kalır (çağrı engellenir).
BULUT_USD_TRY_RATE=

# --- Web araştırması (en az biri; ikisi de boşsa web araçları kapalı) ---
# Brave Search API anahtarı (ücret/limitleri Brave'in sitesinden kontrol et)
BRAVE_API_KEY=
# Kendi SearXNG sunucun (ücretsiz, ayrı servis; JSON formatı açık olmalı), ör. http://searxng:8080
SEARXNG_URL=
# Günlük web araması üst sınırı
BULUT_WEB_DAILY_LIMIT=40

# --- Günlük brifing ---
# Yerel saat (HH:MM). Boş bırakılırsa otomatik brifing kapalı.
BULUT_BRIEF_TIME=08:30
BULUT_TIMEZONE=Europe/Istanbul
# Yalnızca yerel DNS'in olmadığı, tüm trafiğin HTTP vekil sunucusundan geçtiği ortamlarda 1 yap.
# 1 iken çözülemeyen alan adlarının IP denetimini vekil sunucuya bırakırsın (SSRF korumasını zayıflatır).
BULUT_WEB_TRUST_PROXY_DNS=0
